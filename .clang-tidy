---
Checks: >
  -*,
  llvm-*,
  -llvm-include-order,
  -llvm-header-guard,
  -llvm-prefer-static-over-anonymous-namespace,
  -llvm-twine-local,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-derived-method-shadowing-base-method,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-avoid-do-while,
  modernize-*,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-suspicious-call-argument,
  -readability-redundant-member-init

WarningsAsErrors: "*"
FormatStyle: file
HeaderFilterRegex: '.*[/\\]src[/\\]'
HeaderFileExtensions: ["hh"]
ImplementationFileExtensions: ["cc"]
CheckOptions:
  # 1. Namespaces
  readability-identifier-naming.NamespaceCase: lower_case

  # 2. Types
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase

  # 3. Functions
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.IgnoreMainLikeFunctions: true

  # 4. Variables
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.VariableIgnoredRegexp: "^(AST|ID|PP|CLI)"

  # 5. Private members
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberSuffix: "_"
  readability-identifier-naming.PrivateMemberIgnoredRegexp: "^(PP_)"

  # 6. Protected members
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberSuffix: "_"
  readability-identifier-naming.ProtectedMemberIgnoredRegexp: "^(AST|ID|PP|CLI)"

  # 7. Constants
  readability-identifier-naming.GlobalConstantCase: UPPER_CASE
  readability-identifier-naming.StaticConstantCase: UPPER_CASE
  readability-identifier-naming.ConstexprVariableCase: UPPER_CASE
  readability-identifier-naming.ClassConstantCase: UPPER_CASE
  readability-identifier-naming.EnumConstantCase: UPPER_CASE

  # 8. Macros
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
