if(LINUX)
  set(CMAKE_C_COMPILER "clang" CACHE STRING "")
  set(CMAKE_CXX_COMPILER "clang++" CACHE STRING "")
  set(CMAKE_LINKER_TYPE "LLD" CACHE STRING "")
elseif(APPLE)
  set(CMAKE_C_COMPILER "clang" CACHE STRING "")
  set(CMAKE_CXX_COMPILER "clang++" CACHE STRING "")
  set(CMAKE_OSX_DEPLOYMENT_TARGET "15" CACHE STRING "")
elseif(WIN32)
  set(CMAKE_C_COMPILER "clang-cl" CACHE STRING "")
  set(CMAKE_CXX_COMPILER "clang-cl" CACHE STRING "")
  set(CMAKE_LINKER_TYPE "LLD" CACHE STRING "")
  set(CMAKE_ASM_MASM_COMPILER "llvm-ml" CACHE STRING "")
  set(CMAKE_ASM_MASM_FLAGS "-m64" CACHE STRING "")
  set(CMAKE_CXX_COMPILER_AR "llvm-lib" CACHE STRING "")
endif()
