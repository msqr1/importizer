BasedOnStyle: LLVM
ColumnLimit: 100
LineEnding: LF

SortIncludes:
  Enabled: true
IncludeBlocks: Preserve
IncludeIsMainRegex: "$"
IncludeCategories:
  # Main header gets Priority: 0
  - Regex: '".*"'
    Priority: 1
  - Regex: "^<(llvm|clang)/"
    Priority: 2
    CaseSensitive: true
  - Regex: "<.*>"
    Priority: 3

QualifierAlignment: Right
RemoveSemicolon: true
